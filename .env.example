# Slack. slack create writes FINANCE_DESK_SLACK_BOT_TOKEN and FINANCE_DESK_SLACK_APP_TOKEN.
# Channel that receives approval packs, such as C0123ABCDEF.
FINANCE_DESK_SLACK_CHANNEL=
# Slack user IDs allowed to click Approve, comma separated, such as U0123ABCDEF.
# Empty means nobody can approve.
FINANCE_DESK_APPROVER_IDS=

# Optional. Official X API bearer token. Without it, the scout uses wires only.
X_BEARER_TOKEN=

# Optional. Canva Connect token and the brand template to autofill.
# Name the template text fields KICKER, HEADLINE, DEK, STAT, and SOURCE.
CANVA_ACCESS_TOKEN=
CANVA_BRAND_TEMPLATE_ID=

# Metricool comes later. Approve currently saves the pack and posts nothing.
